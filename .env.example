# Opcional. Clave de API de Google (solo "Google Drive API", restringida por referente HTTP)
# para reproducir vídeos de Google Drive con el reproductor propio (continuar viendo,
# contador fiable). Sin ella, los vídeos de Drive usan el visor de Drive.
# Los archivos deben estar compartidos como "Cualquier persona con el enlace".
VITE_GOOGLE_API_KEY=

# Supabase propio de FamilyMemories (cuentas reales con código de 6 dígitos por correo).
# Solo la URL y la clave PUBLICABLE (anon): la seguridad la ponen las políticas RLS.
# NUNCA pongas aquí la clave secreta («Secret key» del panel de Supabase).
# Sin estos valores la app solo funciona como demo local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
